      "required": [
        "passos",
        "decisao_com_todos_resolvidos",
        "linha_com_todos_resolvidos"
      ],
      "title": "ParaAprovar",
      "type": "object"
    },
    "PassoParaAprovar": {
      "additionalProperties": false,
