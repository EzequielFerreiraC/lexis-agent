        "decisao_com_todos_resolvidos": {
          "$ref": "#/$defs/Decisao"
        },
        "linha_com_todos_resolvidos": {
          "title": "Linha Com Todos Resolvidos",
          "type": "string"
        },
        "passos": {
          "items": {
            "$ref": "#/$defs/PassoParaAprovar"
          },
          "title": "Passos",
          "type": "array"
        }
