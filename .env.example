# Copie para .env (nunca commite o .env nem coloque a chave AQUI: este arquivo é versionado).
# Só é necessário para --modo auto/live.
ANTHROPIC_API_KEY=
# Só para chave de usuário (sk-ant-usr-...), que não é vinculada a um workspace: ID do workspace a usar.
# Com chave de workspace (sk-ant-api...), deixe vazio.
ANTHROPIC_WORKSPACE_ID=
# Banco MySQL do docker compose (só na rede interna). Deixe vazio: d_scripts/a_start.sh gera senhas aleatórias.
# Só caracteres seguros em URL (a senha entra no LEXIS_DB_URL).
LEXIS_DB_SENHA=
LEXIS_DB_SENHA_ROOT=
# Fora do Docker (pip), aponte para o seu banco; sem isso, não há banco nem login:
# LEXIS_DB_URL=mysql+pymysql://lexis:<senha>@127.0.0.1:3306/lexis?charset=utf8mb4
# Com banco, quem cria conta pela tela de login: só e-mails destes domínios (vírgula separa). Vazio = qualquer um.
LEXIS_DOMINIOS_EMAIL=
# Modelo configurável; verifique os IDs vigentes na documentação oficial da Anthropic.
LEXIS_MODEL=claude-sonnet-5-5
LEXIS_TIMEOUT_S=120
LEXIS_MAX_RETRIES=2
# Orçamento de tokens (entrada + saída) por execução: aborta o lote ao estourar
LEXIS_TOKEN_BUDGET=200000
# Profundidade de raciocínio do modelo: low | medium | high | xhigh | max
LEXIS_EFFORT=medium
# Fallback do servidor quando o classificador de segurança recusa: default | off (o modelo que respondeu é gravado)
LEXIS_FALLBACKS=default
LEXIS_MAX_TOKENS=16000
